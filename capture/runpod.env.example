# Copy to `runpod.env` and fill in values (runpod.env is gitignored):
#   cp runpod.env.example runpod.env
#
# Loaded by: capture/autossh_setup.sh, capture/run_full_stack.sh
#
# =============================================================================
# Mode A — Direct SSH (root@PUBLIC_IP -p PORT from RunPod “TCP” / dedicated connect)
# =============================================================================
# Full SSH: autossh -L works. You do NOT need RunPod “expose HTTP” or RUNPOD_PUBLIC_URL.
# Point uvicorn at REMOTE_PORT (default 8080) on the pod; the Mac uses a tunnel to it.
#
RUNPOD_IP=<pod-public-ip>
RUNPOD_PORT=<ssh-port>
RUNPOD_SSH_USER=root
RUNPOD_SSH_IDENTITY=${HOME}/.ssh/id_ed25519
#
# Leave empty in Mode A:
RUNPOD_PUBLIC_URL=

# =============================================================================
# Mode B — Gateway only (user@ssh.runpod.io) — no ssh -L
# =============================================================================
# Uncomment and fill only if you use ssh.runpod.io with no direct IP:
# RUNPOD_IP=ssh.runpod.io
# RUNPOD_PORT=22
# RUNPOD_SSH_USER=<user-before-@>
# RUNPOD_PUBLIC_URL=https://...proxy.runpod.net   # or http://ip:port TCP map

# --- Pod repo path (run_full_stack.sh starts uvicorn here)
RUNPOD_REMOTE_REPO=/workspace/hack_usf
RUNPOD_REMOTE_PYTHON=python3

# --- Port uvicorn binds inside the pod (use 8080 to avoid 8000 expose bugs; or any free port)
# REMOTE_PORT=8080
# LOCAL_PORT=8080
# HEALTH_WAIT_SEC=60
