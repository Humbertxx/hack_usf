# Copy to `runpod.env` and fill in values (runpod.env is gitignored):
#   cp runpod.env.example runpod.env
#
# Loaded by: capture/autossh_setup.sh, capture/run_full_stack.sh
#
# --- SSH (RunPod Connect → SSH; used to start uvicorn on the pod)
RUNPOD_IP=ssh.runpod.io
RUNPOD_PORT=22
RUNPOD_SSH_USER=<user-before-@>
RUNPOD_SSH_IDENTITY=${HOME}/.ssh/id_ed25519

# --- REQUIRED on ssh.runpod.io: HTTP proxy (gateway SSH does NOT support ssh -L).
# RunPod dashboard → your pod → Connect → expose port 8080 (HTTP). Use the base URL:
#   RUNPOD_HTTP_URL=https://<something>-8080.proxy.runpod.net
RUNPOD_HTTP_URL=

# --- Pod repo path (run_full_stack.sh starts uvicorn here)
RUNPOD_REMOTE_REPO=/workspace/hack_usf
RUNPOD_REMOTE_PYTHON=python3

# --- Optional (defaults shown)
# LOCAL_PORT=8080
# REMOTE_PORT=8080
# HEALTH_WAIT_SEC=60
